APP_NAME=expense_track_bot
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Serve /docs and /openapi.json. Must be false in production.
DOCS_ENABLED=true

# OpenAI (ChatGPT) — use a key dedicated to this bot so its cost is tracked separately.
BASE_URL=https://api.openai.com
API_KEY=your-openai-api-key-here
# Must be a vision-capable model that supports structured outputs (json_schema).
MODEL=gpt-4o
# Seconds; keep below Vercel's 60s function limit.
TIMEOUT=45

# Every "today"/"this week"/"this month" is computed in this zone. Asia/Makassar = WITA.
TIMEZONE=Asia/Makassar

# Photos read below this confidence (0..1) are rejected and the user is asked to re-shoot.
MIN_RECEIPT_CONFIDENCE=0.5
# Warn when a category's monthly spending reaches this share of its /budget.
BUDGET_WARNING_RATIO=0.8

# Per-chat throttle: RATE_LIMIT_REQUESTS allowed per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Neon Postgres. Paste the postgresql://... URL from the Neon dashboard as-is —
# the app adapts it for asyncpg (driver + sslmode) automatically.
DATABASE_URL=

# Telegram bot integration (webhook mode)
# Token from @BotFather, e.g. 123456:ABC-DEF... (keep secret)
TELEGRAM_BOT_TOKEN=
# Secret passed back by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat IDs allowed to talk to the bot. Empty = any chat.
TELEGRAM_ALLOWED_CHAT_IDS=
